###
# Unknown platform 999: 400
POST http://localhost:5197/games
Content-Type: application/json

{
    "name": "Bad platform game",
    "genreId": 1,
    "platformIds": [1, 999],
    "price": 19.99,
    "releaseDate": "2020-01-01"
}

###
# Unknown platform 999: 400
PUT http://localhost:5197/games/1
Content-Type: application/json

{
    "name": "PA2",
    "genreId": 4,
    "platformIds": [1, 999],
    "price": 19.99,
    "releaseDate": "2011-11-18"
}

###
# No platformIds: treated as an empty list
POST http://localhost:5197/games
Content-Type: application/json

{
    "name": "No platform game",
    "genreId": 1,
    "price": 19.99,
    "releaseDate": "2020-01-01"
}

###
# Platform 1 is used by games: 409
DELETE http://localhost:5197/platforms/1
