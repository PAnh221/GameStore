@page
@model GamesModel

<div class="d-flex justify-content-between align-items-center mb-3">
	<h1>Games</h1>
	<a class="btn btn-success" asp-page="/Index">Home</a>
</div>

@if (Model.Games is null)
{
	<div class="spinner-border text-primary" role="status"><span class="visually-hidden">Loading...</span></div>
}
else if (Model.Games.Count == 0)
{
	<div class="alert alert-warning">No games found.</div>
}
else
{
	<div class="table-responsive">
		<table class="table table-striped table-hover align-middle">
			<thead class="table-dark">
				<tr><th style="width:5%">#</th><th>Name</th><th style="width:20%">Genre</th><th style="width:10%">Price</th><th style="width:15%">Release</th></tr>
			</thead>
			<tbody>
			@foreach (var g in Model.Games)
			{
				<tr>
					<td>@g.Id</td>
					<td>@g.Name</td>
					<td>@g.Genre</td>
					<td>@String.Format("{0:C}", g.Price)</td>
					<td class="release-date">@g.ReleaseDate.ToString("yyyy-MM-dd")</td>
				</tr>
			}
			</tbody>
		</table>
	</div>
}
